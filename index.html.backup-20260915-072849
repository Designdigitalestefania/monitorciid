/* ============ LOG ============ */
function makeLog(elId) {
  const el = document.getElementById(elId);
  if (!el) return { push: () => {} };
  return {
    push(msg, cls = "ok") {
      const t = new Date();
      const ts = `${String(t.getHours()).padStart(2,"0")}:${String(t.getMinutes()).padStart(2,"0")}:${String(t.getSeconds()).padStart(2,"0")}`;
      const line = document.createElement("div");
      line.className = "line";
      line.innerHTML = `<span class="ts">[${ts}]</span> <span class="${cls}">${msg}</span>`;
      el.appendChild(line);
      el.scrollTop = el.scrollHeight;
    }
  };
}

function renderPipeline(containerId, demo, onSelect, liveState) {
  const el = document.getElementById(containerId);
  el.innerHTML = "";
  ESTADOS.forEach((estado, i) => {
    const div = document.createElement("div");
    div.className = "step";
    if (i < demo.estado) div.classList.add("done");
    if (i === demo.estado) div.classList.add("active");
    if (i > demo.estado) div.classList.add("pending");
    if (liveState && i === demo.estado && liveState.running) div.classList.add("processing");
    div.innerHTML = `<span class="dot"></span><span>${LABELS[estado]}</span>${liveState && i === demo.estado && liveState.running ? '<span class="spin"></span>' : ''}`;
    div.onclick = () => onSelect(i);
    el.appendChild(div);
  });
}

function renderExpediente(id, obj) {
  const el = document.getElementById(id);
  el.innerHTML = Object.entries(obj).map(([k, v]) =>
    `<div class="item"><div class="label">${k}</div><div>${v}</div></div>`
  ).join("");
}

function badge(text, cls) { return `<span class="badge ${cls}">${text}</span>`; }
function actor(icon, name) { return `<span class="actor">${icon} ${name}</span>`; }

function typewriter(el, html, speed = 25) {
  return new Promise(resolve => {
    el.innerHTML = "";
    el.classList.add("typing");
    const temp = document.createElement("div");
    temp.innerHTML = html;
    const plain = temp.textContent;
    let i = 0;
    const interval = setInterval(() => {
      if (i >= plain.length) {
        clearInterval(interval);
        el.innerHTML = html;
        el.classList.remove("typing");
        resolve(); return;
      }
      el.textContent = plain.slice(0, i + 1);
      i += 1;
    }, Math.max(8, 40 - speed));
  });
}

