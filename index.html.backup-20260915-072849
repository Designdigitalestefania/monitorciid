<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>MONITOR CIID · Pipeline en vivo</title>
<link rel="icon" href="assets/logo-ciid-mini.svg">
<link rel="manifest" href="manifest.json">
<meta name="theme-color" content="#0e1116">
<meta name="apple-mobile-web-app-capable" content="yes">
<style>
  :root {
    --bg: #0e1116;
    --panel: #161b22;
    --panel-2: #1c2230;
    --border: #2a3140;
    --text: #e6edf3;
    --muted: #8b949e;
    --accent: #4c8bf5;
    --accent-2: #0a4fff;
    --ok: #2ea043;
    --warn: #d29922;
    --err: #f85149;
    --patrimonio: #a371f7;
    --live: #ff5c8a;
    --oro: #b08d57;
  }
  * { box-sizing: border-box; }
  body {
    margin: 0;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    background: var(--bg);
    color: var(--text);
    line-height: 1.5;
  }
  header {
    padding: 12px 24px;
    border-bottom: 1px solid var(--border);
    display: flex;
    justify-content: space-between;
    align-items: center;
    background: var(--panel);
    position: sticky;
    top: 0;
    z-index: 10;
    gap: 16px;
    flex-wrap: wrap;
  }
  .brand { display: flex; align-items: center; gap: 12px; }
  .brand img { width: 48px; height: 48px; }
  .brand h1 { margin: 0; font-size: 16px; letter-spacing: 1px; }
  .brand .sub { font-size: 10.5px; color: var(--muted); margin-top: 2px; max-width: 620px; }
  header .right { display: flex; align-items: center; gap: 10px; }
  header .tag {
    font-size: 10px; background: var(--err);
    padding: 3px 8px; border-radius: 4px;
    letter-spacing: 1px; font-weight: 700;
  }
  header .live {
    display: inline-flex; align-items: center; gap: 6px;
    font-size: 11px; color: var(--live);
    letter-spacing: 1px; font-weight: 700;
  }
  header .live::before {
    content: ""; width: 8px; height: 8px; border-radius: 50%;
    background: var(--live);
    box-shadow: 0 0 0 0 rgba(255,92,138,.7);
    animation: pulse 1.6s infinite;
  }
  @keyframes pulse {
    0% { box-shadow: 0 0 0 0 rgba(255,92,138,.7); }
    70% { box-shadow: 0 0 0 10px rgba(255,92,138,0); }
    100% { box-shadow: 0 0 0 0 rgba(255,92,138,0); }
  }
  .tabs {
    display: flex; gap: 4px; padding: 10px 24px 0;
    border-bottom: 1px solid var(--border);
    background: var(--panel);
    position: sticky; top: 73px; z-index: 9;
    overflow-x: auto;
  }
  .tab {
    padding: 10px 16px;
    border: 1px solid transparent; border-bottom: none;
    background: transparent; color: var(--muted);
    cursor: pointer; border-radius: 6px 6px 0 0;
    font-size: 13px; white-space: nowrap;
  }
  .tab.active {
    background: var(--bg); color: var(--text);
    border-color: var(--border);
    border-bottom: 1px solid var(--bg);
    margin-bottom: -1px;
  }
  main { padding: 16px; max-width: 1700px; margin: 0 auto; }
  .grid {
    display: grid;
    grid-template-columns: 260px 1fr 320px;
    gap: 14px; align-items: start;
  }
  @media (max-width: 1100px) { .grid { grid-template-columns: 1fr; } }

  .panel {
    background: var(--panel);
    border: 1px solid var(--border);
    border-radius: 10px;
    padding: 14px;
  }
  .panel h2 {
    margin: 0 0 10px; font-size: 11px;
    text-transform: uppercase; letter-spacing: 1.5px;
    color: var(--muted);
  }

  .pipeline { display: flex; flex-direction: column; gap: 4px; }
  .step {
    display: flex; align-items: center; gap: 10px;
    padding: 9px 12px; border-radius: 8px;
    border: 1px solid var(--border);
    background: var(--panel-2);
    cursor: pointer; font-size: 12px;
    transition: all .15s;
  }
  .step:hover { border-color: var(--accent); }
  .step.active { border-color: var(--accent); background: #1a2740; }
  .step.done { border-color: rgba(46,160,67,.4); }
  .step.done .dot { background: var(--ok); }
  .step.pending { opacity: .45; }
  .step.processing { border-color: var(--live); background: #241a22; }
  .step.processing .dot { background: var(--live); animation: pulse 1s infinite; }
  .dot {
    width: 10px; height: 10px; border-radius: 50%;
    background: var(--muted); flex-shrink: 0;
  }
  .step.active .dot { background: var(--accent); box-shadow: 0 0 0 4px rgba(76,139,245,.2); }
  .step .spin {
    margin-left: auto; width: 12px; height: 12px;
    border: 2px solid var(--live); border-top-color: transparent;
    border-radius: 50%; animation: spin .8s linear infinite;
  }
  @keyframes spin { to { transform: rotate(360deg); } }

  .stage-title {
    font-size: 11px; color: var(--muted);
    text-transform: uppercase; letter-spacing: 1.5px;
    margin-bottom: 8px;
    display: flex; justify-content: space-between; align-items: center;
  }
  .stage-body {
    background: var(--panel-2);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 16px;
    min-height: 420px;
  }
  .meta-row {
    display: flex; justify-content: space-between;
    padding: 7px 0;
    border-bottom: 1px dashed var(--border);
    font-size: 13px; gap: 12px;
  }
  .meta-row:last-child { border-bottom: none; }
  .meta-row .k { color: var(--muted); flex-shrink: 0; }
  .meta-row .v { text-align: right; }

  .badge {
    display: inline-block;
    padding: 3px 8px; border-radius: 4px;
    font-size: 10px; letter-spacing: 1px;
    text-transform: uppercase; font-weight: 700;
  }
  .badge.ok { background: rgba(46,160,67,.15); color: var(--ok); }
  .badge.warn { background: rgba(210,153,34,.15); color: var(--warn); }
  .badge.err { background: rgba(248,81,73,.15); color: var(--err); }
  .badge.info { background: rgba(76,139,245,.15); color: var(--accent); }
  .badge.patrimonio { background: rgba(163,113,247,.15); color: var(--patrimonio); }
  .badge.live { background: rgba(255,92,138,.15); color: var(--live); }

  .actor {
    display: inline-flex; align-items: center; gap: 5px;
    font-size: 11px; padding: 3px 9px; border-radius: 12px;
    background: rgba(255,255,255,.05);
    margin-right: 6px; margin-bottom: 6px;
  }

  .btn {
    background: var(--accent); color: white;
    border: none; padding: 10px 16px;
    border-radius: 6px; cursor: pointer;
    font-size: 13px; font-weight: 600;
    margin-right: 8px; margin-top: 12px;
    transition: all .15s;
  }
  .btn.secondary { background: var(--panel-2); border: 1px solid var(--border); color: var(--text); }
  .btn.danger { background: var(--err); }
  .btn:disabled { opacity: .4; cursor: not-allowed; }
  .btn:hover:not(:disabled) { filter: brightness(1.1); transform: translateY(-1px); }

  .expediente { font-size: 13px; }
  .expediente .item { padding: 7px 0; border-bottom: 1px dashed var(--border); }
  .expediente .item:last-child { border-bottom: none; }
  .expediente .label {
    color: var(--muted); font-size: 10px;
    text-transform: uppercase; letter-spacing: 1px;
    margin-bottom: 2px;
  }

  .audio-box {
    background: #0b0e13; border: 1px solid var(--border);
    border-radius: 6px; padding: 10px;
    display: flex; align-items: center; gap: 10px;
    font-size: 12px; color: var(--muted);
    flex-wrap: wrap;
  }
  .audio-wave { display: flex; gap: 2px; align-items: center; height: 24px; }
  .audio-wave span {
    display: block; width: 2px; background: var(--patrimonio);
    border-radius: 2px; animation: wave 1.4s ease-in-out infinite;
  }
  .audio-wave span:nth-child(1){height:8px;animation-delay:0s}
  .audio-wave span:nth-child(2){height:18px;animation-delay:.1s}
  .audio-wave span:nth-child(3){height:12px;animation-delay:.2s}
  .audio-wave span:nth-child(4){height:22px;animation-delay:.3s}
  .audio-wave span:nth-child(5){height:10px;animation-delay:.4s}
  .audio-wave span:nth-child(6){height:16px;animation-delay:.5s}
  @keyframes wave { 0%,100%{transform:scaleY(1)} 50%{transform:scaleY(1.6)} }

  .media-card {
    background: #0b0e13; border: 1px solid var(--border);
    border-radius: 8px; overflow: hidden;
    display: flex; flex-direction: column;
  }
  .media-card img, .media-card svg {
    width: 100%; height: 140px;
    object-fit: cover; display: block;
  }
  .media-card img[src*="card"] {
    height: auto !important;
    max-height: 460px;
    object-fit: contain;
    background: #0b0e13;
  }
  .media-caption {
    padding: 6px 10px; font-size: 11px;
    color: var(--muted);
    border-top: 1px solid var(--border);
  }

  .nota-generada {
    background: #ffffff; color: #1a1a1a;
    border-radius: 10px; padding: 22px;
    margin-top: 12px;
    box-shadow: 0 4px 20px rgba(0,0,0,.4);
    font-family: Georgia, serif;
  }
  .nota-generada .kicker {
    font-family: -apple-system, sans-serif;
    font-size: 10px; letter-spacing: 2px;
    text-transform: uppercase; color: #c0392b;
    font-weight: 700; margin-bottom: 6px;
  }
  .nota-generada h3 {
    margin: 0 0 12px; font-size: 22px;
    line-height: 1.25; color: #0e1116;
  }
  .nota-generada .sumario {
    font-size: 15px; color: #444;
    border-left: 3px solid #c0392b;
    padding-left: 12px; margin-bottom: 16px;
    font-style: italic;
  }
  .nota-generada .cuerpo p {
    margin: 0 0 12px; font-size: 15px; line-height: 1.65;
  }
  .nota-generada .firma {
    font-family: -apple-system, sans-serif;
    font-size: 11px; color: #888;
    margin-top: 16px; padding-top: 12px;
    border-top: 1px solid #eee;
  }
  .nota-generada .lang-tag {
    display: inline-block;
    font-family: -apple-system, sans-serif;
    font-size: 10px; letter-spacing: 1px;
    background: #f3e8ff; color: #6b21a8;
    padding: 3px 8px; border-radius: 4px;
    margin-bottom: 10px;
  }

  /* Versión en lengua originaria */
  .nota-lengua {
    background: #0b0e13;
    border: 1px solid var(--patrimonio);
    border-radius: 10px;
    padding: 22px;
    box-shadow: 0 4px 20px rgba(163,113,247,.15);
    font-family: Georgia, serif;
    color: #e6edf3;
    position: relative;
    margin-top: 12px;
  }
  .nota-lengua::before {
    content: "DIIDXA' STI' BINNIGOLA'SA · DEMO";
    position: absolute; top: -10px; left: 20px;
    background: var(--patrimonio); color: #ffffff;
    font-family: -apple-system, sans-serif;
    font-size: 9px; font-weight: 800;
    letter-spacing: 2px; padding: 3px 10px;
    border-radius: 4px;
  }
  .nota-lengua .lang-tag {
    display: inline-block;
    font-family: -apple-system, sans-serif;
    font-size: 10px; letter-spacing: 1px;
    background: rgba(163,113,247,.2); color: var(--patrimonio);
    padding: 3px 8px; border-radius: 4px;
    margin-bottom: 10px; font-weight: 700;
  }
  .nota-lengua .kicker {
    font-family: -apple-system, sans-serif;
    font-size: 10px; letter-spacing: 2px;
    text-transform: uppercase; color: var(--patrimonio);
    font-weight: 700; margin-bottom: 6px;
  }
  .nota-lengua h3 {
    margin: 0 0 12px; font-size: 22px;
    line-height: 1.3; color: #ffffff; font-style: italic;
  }
  .nota-lengua .sumario {
    font-size: 15px; color: #c8b6e8;
    border-left: 3px solid var(--patrimonio);
    padding-left: 12px; margin-bottom: 16px;
    font-style: italic;
  }
  .nota-lengua .cuerpo p {
    margin: 0 0 12px; font-size: 15px; line-height: 1.65;
    color: #e6edf3;
  }
  .nota-lengua .firma {
    font-family: -apple-system, sans-serif;
    font-size: 11px; color: #a371f7;
    margin-top: 16px; padding-top: 12px;
    border-top: 1px solid rgba(163,113,247,.3);
  }
  .lang-aviso {
    margin-top: 12px; padding: 8px 12px;
    background: rgba(255,92,138,.08);
    border-left: 3px solid var(--live);
    border-radius: 6px;
    font-family: -apple-system, sans-serif;
    font-size: 11px; color: #ffb3cb;
    line-height: 1.5;
  }
  .lang-aviso strong { color: var(--live); }

  .bilingue-wrap {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px; margin-top: 12px;
  }
  @media (max-width: 900px) {
    .bilingue-wrap { grid-template-columns: 1fr; }
  }

  .lang-toggle {
    display: flex; gap: 6px; margin: 10px 0;
    flex-wrap: wrap;
  }
  .lang-toggle button {
    background: var(--panel-2);
    border: 1px solid var(--border);
    color: var(--muted);
    padding: 6px 12px;
    border-radius: 6px; cursor: pointer;
    font-size: 12px;
  }
  .lang-toggle button.active {
    background: var(--patrimonio);
    border-color: var(--patrimonio);
    color: white; font-weight: 700;
  }

  .formatos-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(210px, 1fr));
    gap: 10px; margin-top: 12px;
  }
  .formato-card {
    background: #0b0e13; border: 1px solid var(--border);
    border-radius: 8px; padding: 12px; font-size: 12px;
  }
  .formato-card .head {
    display: flex; align-items: center; gap: 8px;
    margin-bottom: 8px; font-weight: 600;
    color: var(--accent); font-size: 12px;
  }
  .formato-card .body {
    color: var(--muted); font-size: 11px;
    line-height: 1.5; max-height: 120px; overflow: hidden;
  }

  .live-log {
    background: #05070a; border: 1px solid var(--border);
    border-radius: 8px; padding: 10px 12px;
    font-family: ui-monospace, "SF Mono", Menlo, monospace;
    font-size: 11px; color: #7ee787;
    max-height: 170px; overflow-y: auto;
    margin-top: 12px;
  }
  .live-log .line { margin-bottom: 3px; }
  .live-log .ts { color: #6e7681; }
  .live-log .ok { color: #7ee787; }
  .live-log .info { color: #79c0ff; }
  .live-log .warn { color: #ffa657; }
  .live-log .patrimonio { color: #d2a8ff; }
  .live-log .err { color: #ff7b72; }

  .typing::after {
    content: "▊"; color: var(--accent);
    animation: blink .8s infinite;
  }
  @keyframes blink { 50% { opacity: 0; } }

  .qr-block { text-align: center; margin-bottom: 20px; padding: 22px; }
  .qr-block img { width: 220px; height: 220px; background: white; padding: 12px; border-radius: 12px; }
  .qr-fallback {
    padding: 40px; color: var(--muted); font-size: 12px;
    background: #0b0e13; border: 1px dashed var(--border);
    border-radius: 12px; display: inline-block;
  }
  .qr-fallback code {
    background: #161b22; padding: 2px 6px;
    border-radius: 4px; font-size: 11px;
  }

  .comparativa table { width: 100%; border-collapse: collapse; font-size: 14px; }
  .comparativa th, .comparativa td {
    padding: 10px 14px;
    border-bottom: 1px solid var(--border);
    text-align: left;
  }
  .comparativa th {
    color: var(--muted); font-size: 11px;
    text-transform: uppercase; letter-spacing: 1px;
  }
  .comparativa .yes { color: var(--ok); font-weight: 600; }
  .comparativa .no { color: var(--muted); }
  .comparativa .patrimonio-row { background: rgba(163,113,247,.06); }

  .cierre {
    margin-top: 20px; text-align: center;
    padding: 32px;
    border: 1px solid var(--border);
    border-radius: 12px;
    background: linear-gradient(180deg, var(--panel), var(--bg));
  }
  .cierre img { width: 260px; margin-bottom: 16px; }
  .cierre h2 { font-size: 22px; letter-spacing: 3px; margin: 0 0 8px; }
  .cierre p { color: var(--muted); margin: 4px 0; }
  .cierre .grande { font-size: 16px; color: var(--text); margin: 16px 0; }
  .cierre .oro { color: var(--oro); font-weight: 700; }
</style>
</head>
<body>

<header>
  <div class="brand">
    <img src="assets/logo-ciid-mini.svg" alt="MONITOR CIID">
    <div>
      <h1>MONITOR CIID <span style="color:var(--muted); font-weight:400; font-size:12px;">· pipeline en vivo</span></h1>
      <div class="sub">Centro Inteligente de Información Digital · Todos los contenidos, voces, imágenes y datos son ficticios. Uso exclusivo de demostración.</div>
    </div>
  </div>
  <div class="right">
    <span class="live">EN VIVO</span>
    <span class="tag">DEMO</span>
  </div>
</header>

<div class="tabs">
  <button class="tab active" data-view="demo1">Demo 1 · Institucional</button>
  <button class="tab" data-view="demo2">Demo 2 · Ciudadana + Lengua</button>
  <button class="tab" data-view="comparativa">Comparativa final</button>
</div>

<main>

  <section id="view-demo1">
    <div class="grid">
      <aside class="panel">
        <h2>Pipeline CIID</h2>
        <div class="pipeline" id="pipeline1"></div>
      </aside>
      <section class="panel">
        <div class="stage-title">
          <span id="stage-title1">Estado actual</span>
          <span id="stage-clock1" style="color:var(--live); font-family:ui-monospace,monospace;"></span>
        </div>
        <div class="stage-body" id="stage-body1"></div>
        <div id="stage-actions1"></div>
      </section>
      <aside class="panel">
        <h2>Expediente</h2>
        <div class="expediente" id="expediente1"></div>
      </aside>
    </div>
  </section>

  <section id="view-demo2" style="display:none;">
    <div class="grid">
      <aside class="panel">
        <h2>Pipeline CIID</h2>
        <div class="pipeline" id="pipeline2"></div>
      </aside>
      <section class="panel">
        <div class="stage-title">
          <span id="stage-title2">Estado actual</span>
          <span id="stage-clock2" style="color:var(--live); font-family:ui-monospace,monospace;"></span>
        </div>
        <div class="stage-body" id="stage-body2"></div>
        <div id="stage-actions2"></div>
      </section>
      <aside class="panel">
        <h2>Expediente</h2>
        <div class="expediente" id="expediente2"></div>
      </aside>
    </div>
  </section>

  <section id="view-comparativa" style="display:none;">
    <div class="qr-block panel">
      <h2>Abre esta demo en tu celular</h2>
      <img src="assets/qr-demo.png" alt="QR demo"
           onerror="this.outerHTML='<div class=\'qr-fallback\'>Coloca aquí <code>assets/qr-demo.png</code><br><br>Genera con:<br><code>qrencode -o assets/qr-demo.png -s 10 -m 2 &quot;TU_URL&quot;</code></div>'">
      <p style="color:var(--muted); font-size:13px; margin-top:12px;">
        Escanea para navegar el piloto completo desde tu teléfono.
      </p>
    </div>

    <div class="panel comparativa">
      <h2>Resultado del ecosistema</h2>
      <table>
        <thead>
          <tr><th>Etapa</th><th>Demo 1 · Institucional</th><th>Demo 2 · Ciudadana + Lengua</th></tr>
        </thead>
        <tbody>
          <tr><td>Ingesta</td><td class="yes">✓</td><td class="yes">✓</td></tr>
          <tr><td>Normalización</td><td class="yes">✓</td><td class="yes">✓</td></tr>
          <tr><td>Clasificación</td><td class="yes">✓</td><td class="yes">✓</td></tr>
          <tr><td>Asistencia editorial</td><td class="yes">✓</td><td class="yes">✓</td></tr>
          <tr><td>Verificación</td><td class="yes">✓</td><td class="yes">✓</td></tr>
          <tr><td>Decisión humana</td><td class="yes">✓</td><td class="yes">✓</td></tr>
          <tr><td>Distribución multiformato</td><td class="yes">✓</td><td class="yes">✓</td></tr>
          <tr><td>Métricas</td><td class="yes">✓</td><td class="yes">✓</td></tr>
          <tr><td>Participación ciudadana</td><td class="no">—</td><td class="yes">✓</td></tr>
          <tr><td>Lengua originaria</td><td class="no">—</td><td class="yes">✓</td></tr>
          <tr><td>Validación lingüística</td><td class="no">—</td><td class="yes">✓</td></tr>
          <tr class="patrimonio-row"><td>Preservación patrimonial</td><td class="no">—</td><td class="yes" style="color:var(--patrimonio);">✓ Archivo vivo</td></tr>
        </tbody>
      </table>
    </div>

    <div class="cierre">
      <img src="assets/logo-ciid.svg" alt="MONITOR CIID">
      <h2>MONITOR CIID</h2>
      <p class="grande">La tecnología asiste. <span class="oro">El periodista decide.</span></p>
      <p>Innovar para informar. Digitalizar para preservar.</p>
      <p style="margin-top:16px; letter-spacing:2px;">De Oaxaca para el mundo. 🌎</p>
    </div>
  </section>

</main>

<script>
const ESTADOS = ["RECEIVED","PROCESSING","CLASSIFIED","EDITORIAL_REVIEW","VERIFICATION","DECISION","PUBLISHED","PRESERVED"];
const LABELS = {
  RECEIVED: "Ingesta",
  PROCESSING: "Normalización",
  CLASSIFIED: "Clasificación",
  EDITORIAL_REVIEW: "Asistencia editorial",
  VERIFICATION: "Verificación",
  DECISION: "Decisión periodística",
  PUBLISHED: "Publicación",
  PRESERVED: "Preservación"
};

