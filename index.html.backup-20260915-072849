/* ============ CONTROL ============ */
const live1 = { running: false };
const live2 = { running: false };

function actualizar(n) {
  if (n === 1) {
    renderExpediente("expediente1", demo1.expediente);
    renderStageDemo1(demo1.estado, live1);
  } else {
    renderExpediente("expediente2", demo2.expediente);
    renderStageDemo2(demo2.estado, live2);
  }
}
function avanzar(n) {
  const d = n === 1 ? demo1 : demo2;
  if (d.estado < ESTADOS.length - 1) d.estado++;
  actualizar(n);
}
function decidir(n, accion) {
  const d = n === 1 ? demo1 : demo2;
  if (accion === "APROBAR") d.estado = ESTADOS.indexOf("PUBLISHED");
  else if (accion === "DEVOLVER") d.estado = ESTADOS.indexOf("EDITORIAL_REVIEW");
  else if (accion === "RECHAZAR") d.estado = ESTADOS.indexOf("RECEIVED");
  actualizar(n);
}
function reiniciar(n) {
  const d = n === 1 ? demo1 : demo2;
  d.estado = 0;
  actualizar(n);
}

document.querySelectorAll(".tab").forEach(tab => {
  tab.onclick = () => {
    document.querySelectorAll(".tab").forEach(t => t.classList.remove("active"));
    tab.classList.add("active");
    ["demo1","demo2","comparativa"].forEach(v => {
      document.getElementById("view-" + v).style.display = "none";
    });
    document.getElementById("view-" + tab.dataset.view).style.display = "block";
  };
});

const params = new URLSearchParams(location.search);
const demoInicial = params.get("demo");
if (demoInicial === "2") document.querySelector('.tab[data-view="demo2"]').click();
else if (demoInicial === "comp") document.querySelector('.tab[data-view="comparativa"]').click();

const audience = params.get("audience");
if (audience) {
  document.querySelector(".brand h1").innerHTML += ` <span style="color:var(--muted); font-weight:400; font-size:12px;">· ${audience}</span>`;
}

actualizar(1);
actualizar(2);
